  "pptx_高温作业专用服装设计.pptx": [
    [
      "高温作业专用服装设计"
    ],
    [
      "基本假设",
      "各材质是均匀的",
      "热量只沿着材料的厚度方向传播（问题可看作是一个一维的热传导问题）",
